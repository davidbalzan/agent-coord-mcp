{
  "name": "agent-coord-mcp",
  "version": "0.12.0",
  "description": "File-backed MCP server for coordinating multiple AI coding agents (Claude Code, Cursor, Cline, etc.). Local stdio or networked over Streamable HTTP.",
  "type": "module",
  "bin": {
    "agent-coord-mcp": "dist/server.js",
    "coord-chat": "scripts/coord-chat.mjs",
    "coord-pusher": "scripts/coord-pusher.mjs"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "pretest": "tsc",
    "test": "node --test \"test/*.test.mjs\""
  },
  "files": [
    "dist",
    "src",
    "hooks",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/davidbalzan/agent-coord-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "agents",
    "multi-agent",
    "coordination",
    "ai",
    "llm",
    "claude",
    "claude-code",
    "cursor",
    "cline",
    "anthropic",
    "ipc",
    "chat",
    "tmux"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
